<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="@string/appbar_scrolling_view_behavior"
    tools:context=".Home"
    tools:showIn="@layout/activity_home"
    android:orientation="vertical"
    >

    <LinearLayout

        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#ffffff">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:orientation="vertical"
            android:background="@drawable/homeback"
            >
            <de.hdodenhof.circleimageview.CircleImageView
                xmlns:app="http://schemas.android.com/apk/res-auto"
                android:id="@+id/pro"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginStart="150dp"
                android:layout_marginTop="30dp"
                android:src="@mipmap/pro" />
            <TextView
                android:textStyle="bold"
                android:layout_marginTop="5dp"
                android:layout_below="@+id/pro"
                android:gravity="center"
                android:text=""
                android:id="@+id/role"
                android:textColor="@color/white"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                >

            </TextView>
            <TextView
                android:textStyle="bold"
                android:layout_below="@+id/role"
                android:text=""
                android:gravity="center"
                android:id="@+id/name"
                android:textColor="@color/white"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

            </TextView>
            <TextView
                android:layout_below="@+id/name"
                android:text=""
               android:textStyle="bold"
                android:gravity="center"
                android:id="@+id/enrollment"
                android:textColor="@color/white"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
            </TextView>
        </RelativeLayout>

        <LinearLayout
            android:layout_marginTop="-60dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:layout_marginLeft="5dp"
            android:padding="10dp"
            android:gravity="center">
            <androidx.cardview.widget.CardView
                android:id="@+id/addmsg"
                app:cardCornerRadius="10dp"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="5dp"
                android:background="@color/pink">

                <ImageView
                    android:padding="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@mipmap/addmessage">

                </ImageView>
                <TextView
                    android:layout_marginBottom="2dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Add Message"
                    android:layout_gravity="bottom"
                    android:layout_marginLeft="30dp"
                    android:textColor="@color/colorPrimaryDark"
                    android:textSize="16dp"></TextView>



            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView
                android:id="@+id/viewmsg"
                android:layout_marginLeft="15dp"
                android:layout_width="150dp"
                android:layout_height="150dp"
                app:cardCornerRadius="10dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="5dp"
                android:background="@color/pink">
                <ImageView
                    android:padding="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@mipmap/viewmessage">

                </ImageView>
                <TextView
                    android:layout_marginBottom="2dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="View Messages"
                    android:layout_gravity="bottom"
                    android:layout_marginLeft="20dp"
                    android:textColor="@color/colorPrimaryDark"
                    android:textSize="16dp"></TextView>




            </androidx.cardview.widget.CardView>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:layout_marginLeft="5dp"
            android:padding="10dp"
            android:gravity="center">
            <androidx.cardview.widget.CardView
                android:id="@+id/feedback"
                app:cardCornerRadius="10dp"
                android:layout_width="150dp"
                android:layout_marginBottom="3dp"
                android:layout_height="150dp"
                android:background="@color/pink"

                >
                <ImageView
                    android:padding="4dp"
                    android:layout_marginBottom="10dp"
                    android:layout_marginLeft="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@mipmap/msgstatus">

                </ImageView>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Message Status"
                    android:layout_gravity="bottom"
                    android:layout_marginLeft="16dp"
                    android:layout_marginBottom="2dp"
                    android:textColor="@color/colorPrimaryDark"
                    android:textSize="16dp"></TextView>



            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView
                android:layout_marginLeft="15dp"
                android:id="@+id/editprofile"
                app:cardCornerRadius="10dp"
                android:layout_width="150dp"
                android:layout_marginBottom="3dp"
                android:layout_height="150dp"
                android:background="@color/pink"
                >
                <ImageView
                    android:layout_marginTop="-5dp"
                    android:padding="4dp"
                    android:layout_width="match_parent"
                    android:layout_marginBottom="2dp"
                    android:layout_height="match_parent"
                    android:src="@mipmap/mypro">

                </ImageView>
                <TextView
                    android:layout_marginBottom="2dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="My Profile"
                    android:layout_gravity="bottom"
                    android:layout_marginLeft="35dp"
                    android:textColor="@color/colorPrimaryDark"
                    android:textSize="16dp"></TextView>



            </androidx.cardview.widget.CardView>

        </LinearLayout>

        <Button
            android:padding="5dp"
            android:paddingLeft="5dp"
            android:paddingRight="5dp"
            android:id="@+id/logout"
            android:layout_marginTop="20dp"
            android:text="LOGOUT"
            android:textColor="@color/white"
            android:textSize="20dp"
            android:layout_gravity="center"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:background="@drawable/buttonstyleblue"
            >

        </Button>
    </LinearLayout>

</ScrollView>


