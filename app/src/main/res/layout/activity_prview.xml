<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".hodview"
    android:orientation="vertical">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_gravity="center"
        android:gravity="center"
        android:layout_margin="7dp"
        android:background="@drawable/back_grad"
        android:padding="10dp">
        <TextView
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="24dp"
            android:id="@+id/tt1"
            android:text="Complaint"
            android:textStyle="bold"
            android:hint="Message"
            android:textColor="@color/white"
            android:layout_marginTop="20dp"/>
        <TextView
            android:gravity="end"
            android:layout_marginTop="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="18dp"
            android:id="@+id/tt3"
            android:text="public"
            android:hint="Public"
            android:textColor="#990C0003"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="18dp"
            android:id="@+id/tt4"
            android:gravity="end"
            android:text="12-12-21"
            android:hint="date"
            android:textColor="@color/white"/>
        <TextView
            android:padding="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="18dp"
            android:gravity="center"
            android:textStyle="bold"
            android:id="@+id/tt2"
            android:text="Student Messages Complaint and Permisssion Student Messages Complaint and Permisssion Student Messages Complaint and Permisssion Student Messages Complaint and Permisssion"
            android:layout_marginTop="10dp"
            android:hint="Message"
            android:textColor="@color/white"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="20dp"/>



    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_gravity="center"
        android:gravity="center"
        android:layout_marginTop="-10dp"
        android:layout_margin="7dp"
        android:background="@drawable/back_grad"
        android:padding="10dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="18dp"
            android:gravity="center"
            android:id="@+id/uname"
            android:text=""
            android:textColor="@color/white"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="18dp"
            android:gravity="center"
            android:id="@+id/uenno"
            android:text=""
            android:textColor="@color/white"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="18dp"
            android:gravity="center"
            android:id="@+id/udept"
            android:text=""
            android:textColor="@color/white"/>

    </LinearLayout>

    <LinearLayout
        android:layout_marginTop="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <Button
            android:layout_width="160dp"
            android:layout_height="wrap_content"
            android:text="GRANT"
            android:id="@+id/hodgrant"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:layout_marginLeft="35dp"
            android:background="@drawable/buttonstyleblue"
            android:clickable="false">

        </Button>
        <Button
            android:layout_width="160dp"
            android:layout_height="wrap_content"
            android:text="REFUSE"
            android:id="@+id/hodref"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:background="@drawable/buttonstyleblue"
            android:layout_marginLeft="20dp">

        </Button>

    </LinearLayout>

</LinearLayout>